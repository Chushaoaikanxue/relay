# Public URL used by the API for Origin validation.
RELAY_ALLOWED_ORIGIN=http://localhost:8080

# Keep 0 for plain HTTP local deployments. Set to 1 behind HTTPS.
RELAY_SECURE_COOKIE=0

# Host port exposed by the combined relay container.
RELAY_HTTP_PORT=8080

# Bind locally by default. Use a HTTPS reverse proxy for remote access.
RELAY_HTTP_BIND=127.0.0.1
